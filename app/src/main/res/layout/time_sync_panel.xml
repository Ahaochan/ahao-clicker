<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/sources_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_spacing" android:text="@string/builtin_source"
        android:textStyle="bold" android:textSize="@dimen/heading_text" android:textColor="@color/text_primary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_selection_hint"
        android:textSize="@dimen/body_text" android:textColor="@color/text_secondary" />
    <GridLayout android:id="@+id/sources" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="2" android:layout_marginTop="@dimen/control_padding_vertical" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/control_padding_vertical" android:textSize="@dimen/body_text" android:textColor="@color/text_primary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_interval_millis"
        android:labelFor="@id/sync_interval" android:layout_marginTop="@dimen/section_spacing"
        android:textStyle="bold" android:textSize="@dimen/body_text" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/sync_interval" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target" android:inputType="number" android:singleLine="true" android:maxLength="8"
        android:importantForAutofill="no" android:imeOptions="actionDone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/interval_range"
        android:textSize="@dimen/caption_text" android:textColor="@color/text_secondary" />
    <Button android:id="@+id/sync_now" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_and_sync" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_clock_hint"
        android:textSize="@dimen/caption_text" android:textColor="@color/text_secondary" />
  </LinearLayout>
</ScrollView>
