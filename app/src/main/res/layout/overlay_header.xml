<?xml version="1.0" encoding="utf-8"?>
<com.ahao.clicker.OverlayHeader xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
  <ImageButton android:id="@+id/toggle_click" android:layout_width="@dimen/overlay_button_target"
      android:layout_height="@dimen/overlay_button_target"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_click_toggle" android:scaleType="fitCenter" android:contentDescription="@string/auto_click_start" />
  <ImageButton android:id="@+id/add_point" android:layout_width="@dimen/overlay_button_target"
      android:layout_height="@dimen/overlay_button_target" android:visibility="gone"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_add" android:scaleType="fitCenter" android:contentDescription="@string/multi_add_point" />
  <ImageView android:id="@+id/overlay_drag" android:layout_width="@dimen/overlay_button_target" android:layout_height="@dimen/overlay_button_target"
      android:src="@drawable/ic_drag" android:scaleType="fitCenter"
      android:contentDescription="@string/clock_drag" />
  <ImageButton android:id="@+id/close_overlay" android:layout_width="@dimen/overlay_button_target"
      android:layout_height="@dimen/overlay_button_target"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_close" android:scaleType="fitCenter" android:contentDescription="@string/clock_close" />
</com.ahao.clicker.OverlayHeader>
