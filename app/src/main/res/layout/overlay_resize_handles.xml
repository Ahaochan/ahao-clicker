<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="@dimen/overlay_resize_target"
    android:orientation="horizontal">
  <ImageView android:id="@+id/resize_bottom_left" android:layout_width="@dimen/overlay_resize_width"
      android:layout_height="match_parent" android:src="@drawable/ic_resize_corner_left"
      android:scaleType="center" android:focusable="true" android:contentDescription="@string/resize_bottom_left" />
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
  <ImageView android:id="@+id/resize_bottom_right" android:layout_width="@dimen/overlay_resize_width"
      android:layout_height="match_parent" android:src="@drawable/ic_resize_corner"
      android:scaleType="center" android:focusable="true" android:contentDescription="@string/resize_bottom_right" />
</LinearLayout>
