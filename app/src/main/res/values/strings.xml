  <string name="sync_interval">同步间隔（毫秒，1000—86400000）</string>
  <string name="periodic_sync">开启周期同步</string>
  <string name="save_source">保存时间源</string>
  <string name="sync_now">立即同步</string>
  <string name="click_task">定时点击任务</string>
  <string name="step_help">每行一个点：x,y,点击前等待毫秒。一个点为连点，多个点依次循环。任务首点立即执行；后续点击等待其对应行的间隔，以上次手势完成为起点。坐标使用屏幕像素。</string>
  <string name="steps">点击步骤</string>
  <string name="click_count">总点击次数（不是循环次数）</string>
  <string name="start_time">开始时间</string>
  <string name="end_time">结束时间</string>
  <string name="fresh_window">设为 3 秒后开始，持续 10 秒</string>
  <string name="record_hint">录制会实际点击目标应用。请先进入目标页面，再在采集层点选；每次完成后可继续点选。浮动按钮区域不用于录制。最多 500 点，结束后返回本应用编辑各点间隔。录制的是点按，不包括拖动和长按。</string>
  <string name="record_points">开始录制并实际点击</string>
  <string name="start_task">启动定时点击</string>
