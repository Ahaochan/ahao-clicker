  <string name="app_name">阿浩点击器</string>
  <string name="app_description">轻量、稳定的 Android 自动点击工具</string>
  <string name="setup_status">配置时间源与点击步骤，再设置执行时间窗。任务次数和截止时刻先达到即停止。</string>
  <string name="time_source">外部时间</string>
